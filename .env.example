# Copy to .env to override. Every value here is the default; none is a secret.

# Host port the emulator listens on (loopback only).
EMULATOR_PORT=45660

# Architecture compactor.zip is built for. Leave unset to use the Docker host's,
# which is what the emulator runs functions on. Real AWS: arm64 (see infra/envs/aws).
# LAMBDA_ARCH=arm64

# Load generator.
LOADGEN_SEED=20261117
LOADGEN_EVENTS=3000
LOADGEN_CONCURRENCY=16
